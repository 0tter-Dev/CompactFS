{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "CompactFS",
  "version": "0.0.0",
  "identifier": "dev.otterdev.compactfs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "CompactFS", "width": 900, "height": 600, "minWidth": 640, "minHeight": 400 }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost; media-src 'self' asset: http://asset.localhost; frame-src asset: http://asset.localhost; style-src 'self'; base-uri 'none'; form-action 'none'",
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
